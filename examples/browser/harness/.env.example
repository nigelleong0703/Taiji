TYPESAFE_API_KEY=
TYPESAFE_MODEL=jev-latest
# Required for TYPE_TEXT. OpenAI-compatible helper; credentials stay server-side.
TEXT_MODEL_API_KEY=
TEXT_MODEL_BASE_URL=https://openrouter.ai/api/v1
TEXT_MODEL=inception/mercury-2.5
TEXT_MODEL_REASONING=none
# Optional: gateways that ignore reasoning.enabled (e.g. deepseek-v4-flash on opencode) need this instead.
# TEXT_MODEL_REASONING_EFFORT=none
# Optional System 2 model, used only when the fast policy is stuck. Unset S2_MODEL_* fall back to TEXT_MODEL_*.
# S2_MODEL=
# S2_MODEL_API=responses
# S2_MODEL_REASONING=minimal
# Optional, for a self-hosted S1 only (training/serve.py, TYPESAFE_URL pointed at it): choose DONE whenever its
# probability reaches this floor. Pick it from that model's calibration report ("done" -> "thresholds").
# DONE_FLOOR=0.1
